### 1. Lấy Token Đăng nhập
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "username": "member1",
  "password": "123456"
}

> {%
    client.global.set("auth_token", response.body.token);
%}

### 2. Xem Profile (US05-F03)
GET http://localhost:8080/api/v1/profile
Authorization: Bearer eyJhbGciOiJIUzUxMiJ9.eyJzdWIiOiJtZW1iZXIxIiwidXNlcklkIjoyLCJyb2xlIjoiTWVtYmVyIiwiaWF0IjoxNzkwNTU4OTI3LCJleHAiOjE3OTA2NDUzMjd9.gcappcdsHGrwKS8sQHexxKkqHJhlh0XAmw5E1bx3jJjMRk5T6STJezIxAvZY1h_39Ve09O6TubB4148LVzghBA

### 3. Cập nhật Profile (US05-F03)
PUT http://localhost:8080/api/v1/profile
Authorization: Bearer eyJhbGciOiJIUzUxMiJ9.eyJzdWIiOiJtZW1iZXIxIiwidXNlcklkIjoyLCJyb2xlIjoiTWVtYmVyIiwiaWF0IjoxNzkwNTU4OTI3LCJleHAiOjE3OTA2NDUzMjd9.gcappcdsHGrwKS8sQHexxKkqHJhlh0XAmw5E1bx3jJjMRk5T6STJezIxAvZY1h_39Ve09O6TubB4148LVzghBA
Content-Type: application/json

{
  "fullName": "Nguyễn Văn Member",
  "email": "member1@example.com",
  "phone": "0912345678",
  "dob": "1995-05-15",
  "gender": "male",
  "fitnessGoal": "Giảm cân",
  "fitnessLevel": "intermediate",
  "healthNotes": "Khỏe mạnh"
}

### 4. Thêm dữ liệu sức khỏe (US05-F04)
POST http://localhost:8080/api/v1/members/2/health-metrics
Authorization: Bearer eyJhbGciOiJIUzUxMiJ9.eyJzdWIiOiJtZW1iZXIxIiwidXNlcklkIjoyLCJyb2xlIjoiTWVtYmVyIiwiaWF0IjoxNzkwNTU4OTI3LCJleHAiOjE3OTA2NDUzMjd9.gcappcdsHGrwKS8sQHexxKkqHJhlh0XAmw5E1bx3jJjMRk5T6STJezIxAvZY1h_39Ve09O6TubB4148LVzghBA
Content-Type: application/json

{
  "metricName": "weight",
  "metricValue": 72.5,
  "unit": "kg"
}

