        <mxCell id="tbl_audit_logs" value="&lt;div style=&quot;margin:0;padding:8px 12px;background:#334155;color:#ffffff;font-weight:bold;font-size:13px;letter-spacing:0.8px;text-align:center;&quot;&gt;AUDIT_LOGS&lt;/div&gt;&lt;div style=&quot;margin:0;padding:3px 10px;font-size:11px;line-height:18px;background:#ffffff;border-bottom:1px solid rgba(0,0,0,0.05);&quot;&gt;&lt;span style=&quot;display:inline-block;width:38px;color:#dc2626;font-weight:bold;font-size:10px;&quot;&gt;PK&lt;/span&gt;&lt;span style=&quot;font-weight:bold;color:#0f172a;&quot;&gt;id&lt;/span&gt;&lt;span style=&quot;float:right;color:#64748b;font-family:Consolas,monospace;font-size:10px;&quot;&gt;BIGINT?&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin:0;padding:3px 10px;font-size:11px;line-height:18px;background:#f8fafc;border-bottom:1px solid rgba(0,0,0,0.05);&quot;&gt;&lt;span style=&quot;display:inline-block;width:38px;color:#0284c7;font-weight:bold;font-size:10px;&quot;&gt;FK&lt;/span&gt;&lt;span style=&quot;color:#0369a1;font-weight:600;&quot;&gt;user_id&lt;/span&gt;&lt;span style=&quot;float:right;color:#64748b;font-family:Consolas,monospace;font-size:10px;&quot;&gt;BIGINT?&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin:0;padding:3px 10px;font-size:11px;line-height:18px;background:#ffffff;border-bottom:1px solid rgba(0,0,0,0.05);&quot;&gt;&lt;span style=&quot;display:inline-block;width:38px;color:#94a3b8;font-size:10px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color:#1e293b;&quot;&gt;action&lt;/span&gt;&lt;span style=&quot;float:right;color:#64748b;font-family:Consolas,monospace;font-size:10px;&quot;&gt;NVARCHAR(100)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin:0;padding:3px 10px;font-size:11px;line-height:18px;background:#f8fafc;border-bottom:1px solid rgba(0,0,0,0.05);&quot;&gt;&lt;span style=&quot;display:inline-block;width:38px;color:#94a3b8;font-size:10px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color:#1e293b;&quot;&gt;entity_type&lt;/span&gt;&lt