        <mxCell id="n1" value="RÀNG BUỘC CƠ SỞ DỮ LIỆU:&#xa;• CHECK (status IN (&#xa;  'waiting',&#xa;  'notified',&#xa;  'expired'))&#xa;&#xa;Filtered Unique Index:&#xa;UNIQUE(class_id, member_id)&#xa;WHERE status = 'waiting'" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#FFF9C4;strokeColor=#FBC02D;fontSize=10;align=left;spacingLeft=8;fontColor=#424242;" vertex="1" parent="1">
